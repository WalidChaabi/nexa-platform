SQL QUERYESSELECT 
c.*
FROM sherin_test.customers c
INNER JOIN sherin_test.campaign_details cd ON cd.customer_id = c.id 
WHERE c.birth IS NOT NULL
AND MONTH(c.birth) = MONTH(NOW() + INTERVAL 1 DAY)
AND DAY(c.birth) = DAY(NOW() + INTERVAL 1 DAY);
